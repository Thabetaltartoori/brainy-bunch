# ---- Brainy Bunch API ----
# Copy this file to `.env` and fill in the values from
# Supabase > Project Settings > API

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The `service_role` key. Server-side only — never paste this into the React app
# and never commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173
