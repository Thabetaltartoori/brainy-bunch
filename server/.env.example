# ---- Brainy Bunch API ----
# Copy this file to `.env` and fill in the values from
# Supabase > Project Settings > API Keys

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Your SECRET key — `sb_secret_...` on new projects, or the long `eyJ...`
# service_role key on older ones. Server-side only: never paste this into
# the React app and never commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173
